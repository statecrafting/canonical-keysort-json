# Enforce LF line endings for all text files in this repository.
# This prevents "LF will be replaced by CRLF" warnings on Windows
# and ensures consistent line endings across all platforms.

# Default: normalize all text files to LF on commit
* text=auto eol=lf

# --- Source code ---
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.vue       text eol=lf

# --- Config / markup ---
*.json      text eol=lf
*.jsonc     text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.xml       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf

# --- Docs ---
*.md        text eol=lf
*.mdx       text eol=lf
*.txt       text eol=lf

# --- Shell / config ---
*.sh        text eol=lf
*.conf      text eol=lf
*.env       text eol=lf
.env*       text eol=lf
Dockerfile* text eol=lf
*.dockerfile text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf
.eslintrc*  text eol=lf
.prettierrc* text eol=lf

# --- Binary: never touch line endings ---
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.webp      binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.otf       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.tgz       binary

# --- Derived-artifact merge driver ---
# Two branches that both regenerated the per-spec / per-package JSON shards
# would conflict textually. The `spec-spine-derived-regen` driver regenerates
# them from the merged tree instead of leaving conflict markers.
#
# Opt-in per clone: nothing happens until `./.githooks/enable-merge-driver.sh`
# registers it in that clone's git config, and a clone that never runs it
# behaves exactly as before. Sharding already removes the common conflict, since
# two PRs touching different specs write disjoint files; this is for the
# same-shard case. It never replaces the staleness gate: the driver resolves the
# textual conflict, and `spec-spine check` on the merge commit is what
# proves the result is what the corpus compiles to.
#
# The globs are the kit's, naming the shard trees and the slices artifact
# rather than a blanket `.derived/**/*.json`, so a future non-shard artifact
# is not silently swept in.
.derived/spec-registry/by-spec/*.json merge=spec-spine-derived-regen
.derived/codebase-index/by-spec/*.json merge=spec-spine-derived-regen
.derived/codebase-index/by-package/*.json merge=spec-spine-derived-regen
.derived/codebase-index/slices.json merge=spec-spine-derived-regen
